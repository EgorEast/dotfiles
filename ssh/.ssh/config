Host *
    ServerAliveInterval 60
    ServerAliveCountMax 30

Host github.com
    HostName github.com
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    PreferredAuthentications publickey
    ProxyCommand none
    Port 22

Host gist.github.com
    HostName gist.github.com
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    PreferredAuthentications publickey
    ProxyCommand none
    Port 22

Host gitlab.com
    HostName gitlab.com
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    PreferredAuthentications publickey
    ProxyCommand none
    Port 22

Host */*
    ProxyCommand ssh $(dirname %h) -W $(basename %h):%p
