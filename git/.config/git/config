[user]
	name = egoreast
	email = egor.east@yandex.ru
[credential]
	helper = libsecret
[init]
	defaultBranch = main
[include]
	path = ~/.config/delta/themes.gitconfig
[core]
	editor = nvim
	fsmonitor = true
	untrackedCache = true
[alias]
	; graph = log --oneline --graph --all --decorate
	graph = ! serie
	graphgpg = log --graph --all --pretty=format:'%C(auto)%h %G? %an %d %s'
	project-summary = !which onefetch && onefetch
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	tool = nvimdiff
	guitool = nvimdiff
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[commit]
	verbose = true
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[merge]
	conflictstyle = zdiff3
	tool = nvimdiff
	guitool = nvimdiff
[pull]
	; rebase = true
[difftool]
	prompt = false
	guiDefault = false
[mergetool]
	prompt = false
	guiDefault = false
	keepBackup = false
[difftool "nvimdiff"]
	ayout = LOCAL,BASE,REMOTE / MERGED + BASE,LOCAL + BASE,REMOTE
[mergetool "nvimdiff"]
	layout = LOCAL,BASE,REMOTE / MERGED + BASE,LOCAL + BASE,REMOTE

[pager]
	diff = delta --line-numbers --features=collared-trogon-egoreast --hyperlinks --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
	log = delta --line-numbers --features=collared-trogon-egoreast --hyperlinks --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
	reflog = delta --line-numbers --features=collared-trogon-egoreast --hyperlinks --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
	show = delta --line-numbers --features=collared-trogon-egoreast --hyperlinks --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
