[user]
	name = egoreast
	email = i@egoreast.ru
[credential]
	helper = libsecret
[init]
  defaultBranch = main
[include]
    path = ~/.config/delta/themes.gitconfig
[core]
	editor = nvim
[alias]
	graph = log --oneline --graph --all --decorate
	graphgpg = log --graph --all --pretty=format:'%C(auto)%h %G? %an %d %s'
