#!/usr/bin/env bash

# Проверка, включен ли переключатель rwin
LAYOUT_STATE=$(setxkbmap -query | grep options)

# Если параметр grp:rwin_toggle отсутствует — перезапустить настройку
if ! echo "$LAYOUT_STATE" | grep -q "grp:rwin_toggle"; then
  echo "Fixing layout setup..." >&2
  setxkbmap -layout us,ru -option grp:rwin_toggle
fi

# Показываем текущую раскладку
KBD=$(xkblayout-state print '%s')
case "$KBD" in
ru) echo "🇷🇺" ;;
us) echo "🇺🇸" ;;
*) echo "$KBD" ;; # fallback
esac
