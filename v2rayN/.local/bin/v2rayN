#!/usr/bin/env bash
ORIGINAL="/opt/v2rayn-bin/v2rayN"

if pgrep -x "v2rayN" >/dev/null 2>&1; then
  if command -v xdotool &>/dev/null; then
    # Ищем все окна v2rayN
    WINDOWS=$(xdotool search --name "v2ray" 2>/dev/null)

    for WID in $WINDOWS; do
      NAME=$(xdotool getwindowname "$WID" 2>/dev/null)

      # Если у окна НЕТ имени → это tray icon → КЛИКАЕМ!
      if [ -z "$NAME" ]; then
        xdotool mousemove --window "$WID" 3 3 click 1 2>/dev/null
        exit 0
      fi
    done

    # Если дошли сюда - активируем первое найденное окно с именем
    echo "$WINDOWS" | head -1 | xargs -I{} xdotool windowactivate --sync {} 2>/dev/null
  fi
  exit 0
fi

nohup "$ORIGINAL" "$@" >/dev/null 2>&1 &
exit 0
