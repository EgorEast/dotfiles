#!/bin/bash
# =============================================================================
# v2rayN-i3 v5.1 - ИСПРАВЛЕНИЕ ОШИБКИ HEREDOC (SC2259)
#
# Изменения:
# - Убран heredoc из pipe (была ошибка SC2259!)
# - Python код передается через -c аргумент корректно
# =============================================================================

APP_NAME="v2rayN"
APP_CMD="/opt/v2rayn-bin/v2rayN"
LOCK_FILE="/tmp/v2rayN-single.lock"
LOG_FILE="/tmp/v2rayN-i3.log"

log() {
  echo "[$(date '+%H:%M:%S')] $1" >>"$LOG_FILE"
}

# =============================================================================
# МЕТОД 1: Поиск окна через i3-msg + python (БЕЗ HEREDOC!)
# =============================================================================
find_window_i3() {
  # Создаем временный python-скрипт (чтобы избежать heredoc в pipe!)
  local PY_SCRIPT=$(
    cat <<'PYTHON_CODE'
import sys, json

def find(nodes, target='v2rayN'):
    for n in nodes:
        name = (n.get('name') or '').lower()
        wc = (n.get('window_properties', {}).get('class') or '').lower()
        wt = (n.get('window_properties', {}).get('title') or '').lower()
        
        if target.lower() in name or target.lower() == wc or target.lower() in wt:
            return n.get('window')
            
        for container in ['nodes', 'floating_nodes']:
            if container in n:
                result = find(n[container], target)
                if result:
                    return result
    return None

tree = json.load(sys.stdin)
result = find([tree])
if result:
    print(result)
PYTHON_CODE
  )

  # Теперь безопасно используем pipe!
  local wid=$(i3-msg -t get_tree | python3 -c "$PY_SCRIPT" 2>/dev/null)

  if [ -n "$wid" ]; then
    echo "$wid"
    return 0
  fi
  return 1
}

# =============================================================================
# МЕТОД 2: Правильная активация окна (Avalonia-safe!)
# =============================================================================
activate_window_properly() {
  local wid=$1

  if [ -z "$wid" ]; then
    return 1
  fi

  log "🔄 Активирую окно $wid..."

  # Шаг 1: Перемещаем на текущий workspace ("будим" Avalonia окно!)
  i3-msg "[id=\"$wid\"] move window to workspace current" >/dev/null 2>&1
  sleep 0.2

  # Шаг 2: Фокусируем
  i3-msg "[id=\"$wid\"] focus" >/dev/null 2>&1
  sleep 0.1

  # Шаг 3: Floating + центр
  i3-msg "[id=\"$wid\"] floating enable" >/dev/null 2>&1
  i3-msg "[id=\"$wid\"] move position center" >/dev/null 2>&1
  sleep 0.1

  # Шаг 4: Наверх
  i3-msg "[id=\"$wid\"] raise" >/dev/null 2>&1

  log "✅ Окно $wid активно!"
  return 0
}

# =============================================================================
# МЕТОД 3: Попытка активации (все методы)
# =============================================================================
try_activate() {
  log "🔍 Поиск окна..."

  # Способ 1: i3-msg (самый надежный!)
  local wid
  wid=$(find_window_i3)

  if [ -n "$wid" ]; then
    log "✅ Найдено через i3 (ID: $wid)"
    activate_window_properly "$wid"
    return $?
  fi

  # Способ 2: xdotool (только для видимых окон!)
  if command -v xdotool &>/dev/null; then
    # Ищем ТОЛЬКО видимые
    wid=$(xdotool search --onlyvisible --class "$APP_NAME" 2>/dev/null | head -n 1)

    if [ -z "$wid" ]; then
      wid=$(xdotool search --onlyvisible --name "$APP_NAME" 2>/dev/null | head -n 1)
    fi

    if [ -n "$wid" ]; then
      log "✅ Найдено через xdotool visible (ID: $wid)"
      activate_window_properly "$wid"
      return $?
    fi

    # Если нет видимых - ищем все (но БЕЗ windowmap!)
    wid=$(xdotool search --class "$APP_NAME" 2>/dev/null | head -n 1)
    if [ -n "$wid" ]; then
      log "⚠️ Найдено скрытое (ID: $wid) - пробуем i3 методы"
      activate_window_properly "$wid"
      return $?
    fi
  fi

  log "❌ Окно не найдено"
  return 1
}

# =============================================================================
# MAIN
# =============================================================================
main() {
  log "==========================================="
  log "Запуск v2rayN-i3 v5.1 (fixed heredoc)"

  # ===========================================
  # ПРОВЕРКА: Процесс уже запущен?
  # ===========================================
  if pgrep -x "$APP_NAME" >/dev/null 2>&1; then
    local PID
    PID=$(pgrep -x $APP_NAME | head -n 1)
    log "📋 Процесс запущен (PID: $PID)"

    if try_activate; then
      echo "✅ v2rayN активирован"
      exit 0
    else
      echo "⚠️ Процесс есть (PID: $PID), но окно не найдено"
      exit 1
    fi
  fi

  # ===========================================
  # ЗАПУСК НОВОГО ЭКЗЕМПЛЯРА
  # ===========================================
  log "🚀 Запуск нового экземпляра..."

  # Блокировка
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    log "❌ Скрипт уже работает"
    echo "❌ Уже запускается..."
    exit 1
  fi

  # Запуск
  $APP_CMD "$@" &
  APP_PID=$!
  log "📝 Запущен PID: $APP_PID"

  # Ждем появления окна
  log "⏳ Ожидаю окно (15с)..."
  SUCCESS=false

  for i in $(seq 1 30); do
    sleep 0.5

    if ! kill -0 $APP_PID 2>/dev/null; then
      log "❌ Процесс умер!"
      break
    fi

    if try_activate; then
      SUCCESS=true
      break
    fi
  done

  if [ "$SUCCESS" = true ]; then
    log "✅ Успех!"
  else
    log "⚠️ Таймаут"
  fi

  exec 9>&-
  wait $APP_PID 2>/dev/null
}

main "$@"
