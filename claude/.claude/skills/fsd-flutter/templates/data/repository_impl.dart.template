  @override
  Future<Either<Failure, PageData<{{EntityName}}Entity>>> filter(
    {{EntityName}}FilterParams params,
  ) async {
    try {
      final request = {{EntityName}}FilterRequest(
        page: params.page,
        size: params.size,
        search: params.search,
        sortBy: params.sortBy,
        sortDirection: params.sortDirection,
        // TODO: Map entity-specific filter fields
