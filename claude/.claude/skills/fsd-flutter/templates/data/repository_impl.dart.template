  @override
  Future<Either<Failure, void>> delete(int id) async {
    try {
      final response = await _remoteDs.delete(id);
      if (!response.success) {
        return Left(Failure.serverError(
          message: response.message ?? 'Failed to delete {{entityName}}',
        ));
      }
      return const Right(null);
    } on DioException catch (e) {
      return Left(_mapDioError(e));
    } catch (e) {
      return Left(Failure.unexpected(message: e.toString()));
    }
  }

  Failure _mapDioError(DioException e) {
    final statusCode = e.response?.statusCode;
    final message = e.response?.data?['message'] as String? ?? e.message ?? 'Unknown error';
    return switch (statusCode) {
      400 => Failure.badRequest(message: message),
      401 => const Failure.unauthorized(),
      403 => const Failure.forbidden(),
      404 => Failure.notFound(message: message),
      409 => Failure.conflict(message: message),
      _ => Failure.serverError(message: message),
    };
  }
