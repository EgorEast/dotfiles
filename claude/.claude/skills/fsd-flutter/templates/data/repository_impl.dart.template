  @override
  Future<Either<Failure, {{EntityName}}Entity>> getById(int id) async {
    try {
      final response = await _remoteDs.getById(id);
      if (!response.success || response.result == null) {
        return Left(Failure.serverError(
          message: response.message ?? 'Failed to get {{entityName}}',
