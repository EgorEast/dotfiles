void main() {
  late {{EntityName}}RepositoryImpl repository;
  late Mock{{EntityName}}RemoteDs mockRemoteDs;

  setUp(() {
    mockRemoteDs = Mock{{EntityName}}RemoteDs();
    repository = {{EntityName}}RepositoryImpl(mockRemoteDs);
  });

  setUpAll(() {
    registerFallbackValue(const {{EntityName}}FilterRequest());
  });

  group('filter', () {
    test('should return PageData<{{EntityName}}Entity> on success', () async {
      const model = {{EntityName}}Model(
        id: 1,
        // TODO: Add entity-specific test values
        createdAt: '2024-01-01T00:00:00',
        updatedAt: '2024-01-01T00:00:00',
      );
      when(() => mockRemoteDs.filter(any())).thenAnswer(
        (_) async => BaseResponse(
          success: true,
          result: PageData(content: [model], page: 0, size: 15, totalElements: 1, totalPages: 1),
        ),
      );

      final result = await repository.filter(t{{EntityName}}FilterParams);

      expect(result.isRight(), true);
      result.fold(
        (l) => fail('Should be Right'),
        (r) {
          expect(r.content.length, 1);
        },
      );
    });

    test('should return Failure when success is false', () async {
      when(() => mockRemoteDs.filter(any())).thenAnswer(
        (_) async => const BaseResponse(success: false, message: 'Error'),
      );

      final result = await repository.filter(t{{EntityName}}FilterParams);

      expect(result.isLeft(), true);
    });
  });
}
